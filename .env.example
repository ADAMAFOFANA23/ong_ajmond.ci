# Copiez ce fichier en .env.local puis renseignez vos propres valeurs.
# .env.local n'est jamais versionné : ce fichier-ci ne doit contenir que des
# exemples, jamais les identifiants d'un vrai projet.

# --- Supabase -------------------------------------------------------------
# Tableau de bord Supabase → Project Settings → API
# URL du projet : bien l'URL HTTPS de l'API, PAS la chaîne de connexion Postgres.
NEXT_PUBLIC_SUPABASE_URL=https://votre-ref-projet.supabase.co
# Clé publique (anon / publishable), exposée au navigateur : c'est normal.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optionnel : uniquement pour des traitements serveur qui doivent contourner
# les politiques RLS. Ne jamais exposer côté navigateur, ni la committer.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site -----------------------------------------------------------------
# Utilisée pour les métadonnées, le sitemap et robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000
